# ------------------------------------------------------------------
# Mistwood Restaurant — environment
# Copy to .env.local for local development, and set the same values
# in your hosting provider's dashboard for production.
# ------------------------------------------------------------------

# Canonical origin used for SEO, Open Graph, sitemap and JSON-LD.
# No trailing slash. Example: https://mistwood-restaurant.example.com
NEXT_PUBLIC_SITE_URL=https://mistwood-restaurant.example.com

# Where the contact form POSTs its JSON payload.
# Leave empty to keep the form validating + confirming in the browser only.
# Works with Formspree, Getform, a Vercel/Netlify function, or your own
# /api/contact route handler. Example:
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/your-form-id
NEXT_PUBLIC_CONTACT_ENDPOINT=
